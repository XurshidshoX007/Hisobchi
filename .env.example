# Railway Postgres service reference
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway Redis service reference
REDIS_URL=${{Redis.REDIS_URL}}

# Telegram BotFather token — secret
BOT_TOKEN=

# Long random value passed to Telegram setWebhook secret_token — secret
WEBHOOK_SECRET=

# Railway-generated public HTTPS URL, e.g. https://your-service.up.railway.app
NEXT_PUBLIC_APP_URL=

# Public BotFather username without @; enables the production /bot launch link.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Shared secret for the scheduled Telegram notification dispatch endpoint.
NOTIFICATION_CRON_SECRET=

# 32+ random bytes; hashes client network identifiers in security logs
LOG_HASH_SECRET=

# Set only if Railway Postgres URL requires TLS over a public endpoint.
# Private Railway networking normally does not require this override.
DATABASE_SSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Never enable in a real production service.
DISABLE_DEMO=true
ALLOW_DEMO_IN_PRODUCTION=false

# Optional deployment/runtime values
NODE_ENV=production
PORT=3000
