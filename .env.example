# Railway Postgres service reference
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway Redis service reference
REDIS_URL=${{Redis.REDIS_URL}}

# Telegram BotFather token — secret
BOT_TOKEN=

# Long random value passed to Telegram setWebhook secret_token — secret
WEBHOOK_SECRET=

# Railway-generated public HTTPS URL, e.g. https://your-service.up.railway.app
NEXT_PUBLIC_APP_URL=

# Public BotFather username without @; enables the production /bot launch link.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Shared secret for the scheduled Telegram notification dispatch endpoint.
NOTIFICATION_CRON_SECRET=

# 32+ random bytes; hashes client network identifiers in security logs
LOG_HASH_SECRET=

# Set only if Railway Postgres URL requires TLS over a public endpoint.
# Private Railway networking normally does not require this override.
DATABASE_SSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Never enable in a real production service.
DISABLE_DEMO=true
ALLOW_DEMO_IN_PRODUCTION=false

# Optional deployment/runtime values
NODE_ENV=production
PORT=3000

# --- Telegram image / document finance intelligence (feature-flagged) ---
# Master switch. Default OFF: roll out to test users first, then flip to true.
# Only the exact string "true" enables it.
IMAGE_INTELLIGENCE_ENABLED=false
# Comma-separated Telegram user ids allowed to use it while the flag is off.
# This is the STAGE 1 rollout: enable yourself before enabling everyone.
IMAGE_INTELLIGENCE_TEST_USERS=
# Vision/OCR provider (OpenAI-compatible chat/completions endpoint) — SECRET.
# Never commit a real value. OPENAI_API_KEY is accepted as a fallback name.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
# Must be a model that accepts IMAGE input on /chat/completions.
# Default when unset: gpt-5.4-mini.
VISION_MODEL=gpt-5.4-mini
# Optional reasoning budget for GPT-5 class models: none|low|medium|high.
VISION_REASONING_EFFORT=
# Hard cap on a single accepted image (bytes). Default 5 MB.
IMAGE_MAX_BYTES=5242880
