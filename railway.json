{  "$schema": "https://railway.com/railway.schema.json",  "build": {    "builder": "DOCKERFILE",    "dockerfilePath": "Dockerfile",    "watchPatterns": [      "src/**",      "public/**",      "scripts/**",      "drizzle/**",      "package.json",      "package-lock.json",      "next.config.ts",      "Dockerfile"    ]  },  "deploy": {    "runtime": "V2",    "numReplicas": 1,    "sleepApplication": false,    "preDeployCommand": "node scripts/migrate.mjs",    "startCommand": "./scripts/start-production.sh",    "healthcheckPath": "/api/health/live",    "healthcheckTimeout": 300,    "overlapSeconds": 20,    "drainingSeconds": 30,    "restartPolicyType": "ON_FAILURE",    "restartPolicyMaxRetries": 10  }}
