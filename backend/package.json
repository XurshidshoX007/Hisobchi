{
  "name": "@hisobchi/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hisobchi backend — Fastify API, Telegram bot webhook, Drizzle ORM (PostgreSQL), Redis rate-limit.",
  "main": "src/index.ts",
  "exports": {
    "./*": "./src/*.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/*-db.test.ts",
    "audit:db": "node scripts/db-preflight.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@hisobchi/shared": "*",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.1",
    "pg": "8.20.0",
    "redis": "^5.8.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
