# ---- Ma'lumot bazasi (Railway Postgres yoki lokal) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hisobchi
# Railway Redis service manzili (lokal dev'da bo'sh qoldirilsa ham ishlaydi)
REDIS_URL=

# ---- Telegram ----
# BotFather tokeni — maxfiy
BOT_TOKEN=
# Telegram setWebhook secret_token — maxfiy (32-256 ta A-Za-z0-9_- belgisi)
WEBHOOK_SECRET=

# ---- Mini App (frontend) ommaviy HTTPS manzili ----
# Backend webhook tugmalari va havolalari uchun foydalanadi.
# Eski NEXT_PUBLIC_APP_URL nomi ham qabul qilinadi.
APP_URL=https://hisobchi.up.railway.app
# Qo'shimcha ruxsat etilgan frontend originlar (vergul bilan; CORS uchun)
FRONTEND_ORIGINS=

# ---- Xavfsizlik ----
# Rejalashtirilgan Telegram bildirishnoma endpointining shared secret'i
NOTIFICATION_CRON_SECRET=
# 32+ tasodifiy bayt; xavfsizlik loglaridagi tarmoq identifikatorlarini hashlaydi
LOG_HASH_SECRET=
# Ishlab chiqishda demo foydalanuvchi (Sardor) — produksiyada HECH QACHON
DISABLE_DEMO=false
ALLOW_DEMO_IN_PRODUCTION=false

# ---- Server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Kalendar-kuni chegarasi (server tomon hisob-kitoblari uchun)
APP_TIMEZONE=Asia/Tashkent
# Postgres pool cap'i (max_connections ga moslab)
DB_POOL_MAX=10

# Public Postgres TLS kerak bo'lsa
DATABASE_SSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# ---- Telegram rasm/hujjat moliyaviy intelligence (feature-flag) ----
IMAGE_INTELLIGENCE_ENABLED=false
IMAGE_INTELLIGENCE_TEST_USERS=
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-5.4-mini
VISION_REASONING_EFFORT=
VISION_IMAGE_DETAIL=auto
IMAGE_MAX_BYTES=5242880
