# --- Hisobchi frontend (Vite) ---
# Barcha VITE_* o'zgaruvchilari build vaqtiga "pchaklanadi" (client ko'radi).

# Backend API bazasiz manzili. Bo'sh (default) = nisbiy /api chaqiruvlari:
#   - dev: Vite proksi → http://127.0.0.1:4000
#   - prod: nginx proksi → BACKEND_ORIGIN
# Faqat API boshqa domenda to'g'ridan-to'g'ri chaqirilsa to'ldiring:
# VITE_API_URL=https://api.hisobchi.uz

# Public bot username'i (@ siz) — /bot sahifasidagi havola uchun.
VITE_TELEGRAM_BOT_USERNAME=

# --- Dev server sozlamalari (package.json scriptlari bilan ham beriladi) ---
# Vite dev-server /api proksisini qayerga yo'naltiradi:
BACKEND_URL=http://127.0.0.1:4000
