# Hisobchi frontend — nginx (statik SPA + API proksi).
# ${PORT}, ${BACKEND_ORIGIN}, ${API_PUBLIC_URL} envsubst orqali almashtiriladi
# (nginx rasmiy image'ning /etc/nginx/templates mexanizmi).

server {
    listen 0.0.0.0:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- SPA fallback (HashRouter ishlatadi, lekin to'liq yo'llar uchun ham xavfsiz) ---
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- API proksi: brauzer nisbiy /api chaqiruvlari backendga boradi ---
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        # Host saqlanadi → backend'dagi same-origin tekshiruvi o'tadi.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # --- Hashlangan statik assetlar: bir yil kesh ---
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html hech qachon keshlanmasin
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # --- Xavfsizlik sarlavhalari (eski src/proxy.ts CSP mantiqi, SPA uchun) ---
    # Vite faqat hashlangan tashqi fayllarni chiqaradi — inline script yo'q,
    # shuning uchun nonce kerak emas. Telegram SDK script'iga https://telegram.org ruxsat.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.telegram.org ${API_PUBLIC_URL}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-DNS-Prefetch-Control "off" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
}
