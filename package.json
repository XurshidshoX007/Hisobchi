{
  "name": "hisobchi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hisobchi — shaxsiy moliya Telegram Mini App'i (monorepo: shared + backend + frontend).",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:all": "npm test && npm run test --workspaces --if-present",
    "test:db": "npm run test:db --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "audit:db": "npm run audit:db --workspace backend",
    "security-smoke": "node backend/scripts/security-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.0"
  }
}
